<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Restore creates a new installation identity and requires an explicit cloud connection. -->
        <exclude domain="sharedpref" path="cloud.xml" />
        <exclude domain="sharedpref" path="cloud_versions.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Cable and wireless transfers must not merge two devices into one configuration slot. -->
        <exclude domain="sharedpref" path="cloud.xml" />
        <exclude domain="sharedpref" path="cloud_versions.xml" />
    </device-transfer>
</data-extraction-rules>
